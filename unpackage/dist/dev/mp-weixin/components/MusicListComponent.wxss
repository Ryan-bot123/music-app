/* 水平间距 */
/* 水平间距 */
.grid-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}
.grid-item {
  box-sizing: border-box;
  padding: 0 5rpx;
  margin-bottom: 20rpx;
}
.grid-item .grid-item-box {
  width: 100%;
  height: auto;
}
.grid-item .grid-item-box image {
  width: 100%;
  height: 200rpx;
}
