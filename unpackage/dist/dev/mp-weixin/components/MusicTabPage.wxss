@charset "UTF-8";
/* 水平间距 */
/* 水平间距 */
.search-bar {
  width: 100%;
  background-color: #00c273;
}
.bannerContent {
  width: 100%;
  height: 320rpx;
}
.bannerContent .swiperImg {
  width: 100%;
  height: 100%;
}
@font-face {
  font-family: CustomFont;
  src: url(data:font/ttf;base64,);
}
.grid {
  display: flex;
  flex-direction: row;
  margin: -30rpx 27rpx 0;
  width: 93%;
  /* 与屏幕保持一定的间隔 */
  position: relative;
  z-index: 10;
}
.grid .grid-item-box {
  flex: 1;
  /* 每个选项平均分宽度 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
  background-color: #00b86b;
}
.grid .grid-item-box .text {
  margin-top: 15rpx;
  font-weight: 600;
  color: #fff;
}
.radio-body {
  margin: 60rpx 20rpx 20rpx;
}
.radio-body .radio-image {
  position: relative;
}
.radio-body .radio-image image {
  width: 90%;
  height: 275rpx;
}
.radio-body .radio-image .radio-text {
  position: absolute;
  top: 50%;
  /* 垂直居中 */
  left: 50%;
  /* 水平居中 */
  -webkit-transform: translate(-60%, -50%);
          transform: translate(-60%, -50%);
  color: white;
  /* 文字颜色 */
  font-size: 30rpx;
  font-weight: bold;
  text-align: center;
}
.radio-body .radio-image .radio-text text {
  display: block;
  margin-top: 10rpx;
}
.radio-body .slot-image {
  display: block;
  margin-right: 10px;
  width: 50px;
  height: 50px;
}
