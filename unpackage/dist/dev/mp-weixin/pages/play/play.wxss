/* 水平间距 */
.container {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}
.container .fullscreen-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  -webkit-filter: blur(12px);
          filter: blur(12px);
}
.container .content {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  -webkit-transform: translateY(-50%);
          transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.container .cover {
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  -webkit-animation: rotate 20s linear infinite;
          animation: rotate 20s linear infinite;
}
.container .control-button {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  background-color: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}
.container .control-button image {
  width: 45rpx;
  height: 45rpx;
}
.container .last-music {
  margin-right: 40rpx;
}
.container .next-music {
  margin-left: 40rpx;
}
@-webkit-keyframes rotate {
from {
    -webkit-transform: rotate(0deg);
            transform: rotate(0deg);
}
to {
    -webkit-transform: rotate(360deg);
            transform: rotate(360deg);
}
}
@keyframes rotate {
from {
    -webkit-transform: rotate(0deg);
            transform: rotate(0deg);
}
to {
    -webkit-transform: rotate(360deg);
            transform: rotate(360deg);
}
}
